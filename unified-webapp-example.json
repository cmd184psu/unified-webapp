{
  "port": 8080,
  "tls_cert": "",
  "tls_key": "",
  "host_routing": {
      "localhost":                  "todo",
  "todo-test.cmdhome.net":      "todo",
  "todolist.cmdhome.net":       "todo",
  "grocery-test.cmdhome.net":       "grocery",
  "slideshow-test.cmdhome.net":       "slideshow",
  "menuserver-test.cmdhome.net":       "menuserver",
  "obsidianoid-test.cmdhome.net":      "obsidianoid",
  "obsidianoid.cmdhome.net":           "obsidianoid",
  "multissh-test.cmdhome.net":         "multissh",
  "certmachine-test.cmdhome.net":      "certmachine",
  "utuber-test.cmdhome.net":           "utuber",
  "admin-test.cmdhome.net":            "admin",
  "smbedit-test.cmdhome.net":          "smbedit",
  "smbedit.cmdhome.net":               "smbedit",
  "issuetracker-test.cmdhome.net":     "issuetracker",
  "timetracker.cmdhome.net":           "timetracker",
  "timetracker-test.cmdhome.net":      "timetracker"
  },
  "server": {
    "origin_check": "enforce",
    "sse_max_subscribers": 64,
    "shared_static_dir": "./web/shared"
  },
  "grocery": {
    "static_dir": "./web/grocery",
    "data_file": "./data/grocery.json",
    "groups": [
      "Produce",
      "Meats",
      "mid store",
      "back wall",
      "frozen",
      "deli area near front"
    ],
    "progress": false,
    "sync_interval_seconds": 1,
    "title": "Grocery List"
  },
  "todo": {
    "static_dir": "./web/todo",
    "data_dir": "./data/todo",
    "ext": "json",
    "default_subject": "home",
    "sync_interval_seconds": 1
  },
  "slideshow": {
    "static_dir": "./web/slideshow",
    "image_dir": "./data/slideshow",
    "prefix": "slides",
    "default_subject": ""
  },
  "menuserver": {
    "static_dir": "./web/menuserver",
    "data_dir": "./data/menuserver",
    "show_all_pages": false
  },
  "obsidianoid": {
    "static_dir": "./web/obsidianoid",
    "data_dir": "./data/obsidianoid",
    "vaults": [
      { "path": "/path/to/your/vault", "name": "My Vault", "theme": "dark" }
    ],
    "threads_folder": "Threads",
    "thread_count": 4,
    "autosave_disabled": false
  },
  "multissh": {
    "static_dir": "./web/multissh",
    "ssh_dir": "",
    "upload_dir": "",
    "hosts_path": "./data/multissh/multissh-hosts.json",
    "browse_root": "",
    "max_sessions": 3,
    "max_upload_bytes": 8589934592,
    "strict_host_key": false,
    "known_hosts_path": ""
  },
  "certmachine": {
    "static_dir": "./web/certmachine",
    "db_path": "./data/certmachine/certmachine.db",
    "legacy_import_dir": "",
    "default_validity_days": 365,
    "expiry_warn_days": 30,
    "trust_device_enabled": false
  },
  "utuber": {
    "static_dir": "./web/utuber",
    "download_dir": "./data/utuber/downloads",
    "workers": 1,
    "python_bin": "python3.12"
  },
  "admin": {
    "static_dir": "./web/admin",
    "max_body_bytes": 1048576
  },
  "smbedit": {
    "static_dir": "./web/smbedit",
    "data_dir": "./data/smbedit",
    "picker_root": "/opt"
  },
  "issuetracker": {
    "static_dir": "./web/issuetracker",
    "db_path": "./data/issuetracker/issues.db",
    "default_user": {
      "name": "Unassigned",
      "email": "unassigned@localhost"
    }
  },
  "timetracker": {
    "static_dir": "./web/timetracker",
    "data_file": "./data/timetracker.json",
    "report_db": "./data/timetracker-reports.db"
  },
  "auth": {
    "modules": {
      "grocery": { "pin_file": "/etc/unified-webapp/grocery.pin" },
      "todo": { "pin_file": "/etc/unified-webapp/todo.pin" },
      "slideshow": { "pin_file": "/etc/unified-webapp/slideshow.pin" },
      "menuserver": { "pin_file": "/etc/unified-webapp/menuserver.pin" },
      "obsidianoid": {},
      "multissh": {},
      "certmachine": { "pin_file": "/etc/unified-webapp/certmachine.pin" },
      "issuetracker": {},
      "admin": {}
    },
    "admin_pin_file": "/etc/unified-webapp/admin.pin",
    "data_dir": "/data/auth",
    "cookie_secure": true,
    "cookie_domain": ".cmdhome.net",
    "session": {
      "ttl_hours": 720,
      "refresh_after_fraction": 0.5
    },
    "ldap": {
      "url": "ldaps://ldap.cmdhome.net:636",
      "start_tls": false,
      "insecure_tls": false,
      "bind_dn": "cn=readonly,dc=cmdhome,dc=net",
      "bind_password": "REPLACE_WITH_BIND_PASSWORD",
      "base_dn": "ou=people,dc=cmdhome,dc=net",
      "user_filter": "(uid=%s)",
      "required_groups": ["cn=household,ou=groups,dc=cmdhome,dc=net"],
      "timeout_seconds": 5
    },
    "api_keys": [
      { "name": "automation", "hash": "sha256:b408256cc1181a47c036389a767e271f39da77e401ad27a28c35805a696b7d22" }
    ],
    "passkey": {
      "rp_id": "cmdhome.net",
      "rp_origins": ["https://obsidianoid.cmdhome.net"]
    }
  }
}